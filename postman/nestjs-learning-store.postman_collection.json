    {
      "name": "GraphQL",
      "item": [
        {
          "name": "Query — products",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Products {\n  products {\n    id\n    name\n    price\n  }\n}",
                "variables": ""
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "GraphQL query: all products."
          },
          "response": []
        },
        {
          "name": "Query — product by id",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Product($id: Int!) {\n  product(id: $id) {\n    id\n    name\n    price\n  }\n}",
                "variables": "{\n  \"id\": 1\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "GraphQL query: one product by id. Change `id` in Variables (or match collection `productId`)."
          },
          "response": []
        },
        {
          "name": "Mutation — createProduct",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateProduct($input: ProductInput!) {\n  createProduct(input: $input) {\n    id\n    name\n    price\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"name\": \"Gadget\",\n    \"price\": 19.5\n  }\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "GraphQL mutation: create product. Input: ProductInput { name, price }."
          },
          "response": []
        },
        {
          "name": "Mutation — updateProduct",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateProduct($id: Int!, $input: UpdateProductInput!) {\n  updateProduct(id: $id, input: $input) {\n    id\n    name\n    price\n  }\n}",
                "variables": "{\n  \"id\": 1,\n  \"input\": {\n    \"name\": \"Updated Gadget\",\n    \"price\": 29.99\n  }\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "GraphQL mutation: update product by id. Input fields are optional: UpdateProductInput { name?, price? }."
          },
          "response": []
        },
        {
          "name": "Mutation — removeProduct",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RemoveProduct($id: Int!) {\n  removeProduct(id: $id)\n}",
                "variables": "{\n  \"id\": 1\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "GraphQL mutation: delete product by id. Returns Boolean."
          },
          "response": []
        },
        {
          "name": "Introspection — schema types",
          "request": {
            "method": "POST",
