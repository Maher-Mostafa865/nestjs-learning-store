{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "NestJS Learning Store",
    "description": "REST and GraphQL endpoints for nestjs-learning-store.\n\nStart the app: `npm run start:dev` (default port 3000).\nSign up or sign in first. The tests save `accessToken` and `refreshToken`.\nCatalog reads are public. Creating, updating, and deleting products requires an admin access token.\nSet `ADMIN_EMAILS` to the sign-up address to receive the ADMIN role.\nUse `productId` for find-one / update / delete requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "email",
      "value": "admin@example.com"
    },
    {
      "key": "password",
      "value": "correct horse battery"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up (POST /auth/sign-up)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/sign-up",
            "description": "Creates a user and returns the user plus access and refresh tokens. Password must be 12-128 characters. Addresses in ADMIN_EMAILS get the ADMIN role."
          },
          "response": []
        },
        {
          "name": "Sign in (POST /auth/sign-in)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/sign-in",
            "description": "Exchanges an email and password for a short-lived access token and a single-use refresh token. Unknown emails and wrong passwords get the same 401."
          },
          "response": []
        },
        {
          "name": "Refresh (POST /auth/token/refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/token/refresh",
            "description": "Spends the refresh token and returns the next pair. Sending a spent token revokes the whole family."
          },
          "response": []
        },
        {
          "name": "Current user (GET /auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me",
            "description": "The signed-in user. Roles are loaded from the database, not from the token."
          },
          "response": []
        },
        {
          "name": "Sign out (POST /auth/sign-out)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/sign-out",
            "description": "Revokes the refresh-token family. The access token stays valid until it expires. Responds 204."
          },
          "response": []
        }
      ]
    },
    {
      "name": "REST",
      "item": [
        {
          "name": "Hello (GET /)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "App root — returns Hello World string."
          },
          "response": []
        },
        {
          "name": "List products (GET /products)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default 1, min 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Page size (default 10, min 1, max 100)"
                }
              ]
            },
            "description": "Paginated product list. Response: { data, meta: { total, page, limit, totalPages } }."
          },
          "response": []
        },
        {
          "name": "Get product by id (GET /products/:id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Get one product by id. Set collection variable `productId`. Returns 404 if not found."
          },
          "response": []
        },
        {
          "name": "Create product (POST /products)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Widget\",\n  \"price\": 9.99\n}"
            },
            "url": "{{baseUrl}}/products",
            "description": "Create a product. Requires an admin access token. Body: name (string), price (number >= 0)."
          },
          "response": []
        },
        {
          "name": "Update product (PATCH /products/:id)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Widget\",\n  \"price\": 12.5\n}"
            },
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Update a product by id. Requires an admin access token. Body: name (string), price (number >= 0). Set collection variable `productId`."
          },
          "response": []
        },
        {
          "name": "Delete product (DELETE /products/:id)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Delete a product by id. Requires an admin access token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "Mutation — signUp",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const signedIn = body.data && body.data.signUp;",
                  "if (signedIn && signedIn.accessToken) pm.collectionVariables.set('accessToken', signedIn.accessToken);",
                  "if (signedIn && signedIn.refreshToken) pm.collectionVariables.set('refreshToken', signedIn.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation SignUp($input: SignUpDto!) {\n  signUp(input: $input) {\n    accessToken\n    refreshToken\n    expiresIn\n    user { id email role }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"admin@example.com\",\n    \"password\": \"correct horse battery\"\n  }\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "Creates an account and returns tokens. Addresses in ADMIN_EMAILS receive the ADMIN role."
          },
          "response": []
        },
        {
          "name": "Mutation — signIn",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const signedIn = body.data && body.data.signIn;",
                  "if (signedIn && signedIn.accessToken) pm.collectionVariables.set('accessToken', signedIn.accessToken);",
                  "if (signedIn && signedIn.refreshToken) pm.collectionVariables.set('refreshToken', signedIn.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation SignIn($input: SignInDto!) {\n  signIn(input: $input) {\n    accessToken\n    refreshToken\n    expiresIn\n    user { id email role }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"admin@example.com\",\n    \"password\": \"correct horse battery\"\n  }\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "Password sign-in. Unknown emails and wrong passwords both return an authentication error."
          },
          "response": []
        },
        {
          "name": "Query — me",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Me {\n  me {\n    id\n    email\n    role\n  }\n}",
                "variables": ""
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "The signed-in user. Send the access token in the Authorization header."
          },
          "response": []
        },
        {
          "name": "Query — products",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Products($query: PaginationQueryDto) {\n  products(query: $query) {\n    data {\n      id\n      name\n      price\n    }\n    meta {\n      total\n      page\n      limit\n      totalPages\n    }\n  }\n}",
                "variables": "{\n  \"query\": {\n    \"page\": 1,\n    \"limit\": 10\n  }\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "GraphQL paginated products. Omit `query` (or leave fields out) to use defaults page=1, limit=10."
          },
          "response": []
        },
        {
          "name": "Query — product by id",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Product($id: Int!) {\n  product(id: $id) {\n    id\n    name\n    price\n  }\n}",
                "variables": "{\n  \"id\": 1\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "GraphQL query: one product by id. Change `id` in Variables (or match collection `productId`)."
          },
          "response": []
        },
        {
          "name": "Mutation — createProduct",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateProduct($input: ProductInput!) {\n  createProduct(input: $input) {\n    id\n    name\n    price\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"name\": \"Gadget\",\n    \"price\": 19.5\n  }\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "Creates a product. Requires an admin access token."
          },
          "response": []
        },
        {
          "name": "Mutation — updateProduct",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateProduct($id: Int!, $input: UpdateProductInput!) {\n  updateProduct(id: $id, input: $input) {\n    id\n    name\n    price\n  }\n}",
                "variables": "{\n  \"id\": 1,\n  \"input\": {\n    \"name\": \"Updated Gadget\",\n    \"price\": 29.99\n  }\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "Updates a product. Requires an admin access token. Input fields are optional."
          },
          "response": []
        },
        {
          "name": "Mutation — removeProduct",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RemoveProduct($id: Int!) {\n  removeProduct(id: $id)\n}",
                "variables": "{\n  \"id\": 1\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "Deletes a product. Requires an admin access token. Returns Boolean."
          },
          "response": []
        },
        {
          "name": "Introspection — schema types",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query SchemaInfo {\n  __schema {\n    queryType {\n      name\n    }\n    mutationType {\n      name\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "Quick check that GraphQL is up."
          },
          "response": []
        }
      ]
    }
  ]
}
