    },
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "Query — products",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Products {\n  products {\n    id\n    name\n    price\n  }\n}",
                "variables": ""
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "GraphQL query: all products."
          },
          "response": []
        },
        {
          "name": "Mutation — createProduct",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateProduct($input: ProductInput!) {\n  createProduct(input: $input) {\n    id\n    name\n    price\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"name\": \"Gadget\",\n    \"price\": 19.5\n  }\n}"
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "GraphQL mutation: create product."
          },
          "response": []
        },
        {
          "name": "Introspection — schema types",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query SchemaInfo {\n  __schema {\n    queryType {\n      name\n    }\n    mutationType {\n      name\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "Quick check that GraphQL is up."
          },
          "response": []
        }
      ]
