              "graphql": {
                "query": "query SchemaInfo {\n  __schema {\n    queryType {\n      name\n    }\n    mutationType {\n      name\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": "{{baseUrl}}/graphql",
            "description": "Quick check that GraphQL is up."
