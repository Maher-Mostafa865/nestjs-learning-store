DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_learning_store

# At least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=

JWT_ISSUER=nestjs-learning-store
JWT_AUDIENCE=nestjs-learning-store
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_ABSOLUTE_TTL=90d

# Comma-separated emails that receive the ADMIN role when they sign up.
ADMIN_EMAILS=admin@example.com
